# Variables del stack (en Portainer: Environment variables del stack)
# Secretos
AIRDCPP_PASS=
BRIDGE_API_KEY=
BRIDGE_PASSWORD=
TMDB_API_KEY=
# Idioma de los titulos (es-ES por defecto; en-US, fr-FR...)
TMDB_LANGUAGE=es-ES
# URLs
BRIDGE_MOVIES_PUBLIC_URL=http://IP-DEL-SERVIDOR:8001
BRIDGE_SERIES_PUBLIC_URL=http://IP-DEL-SERVIDOR:8002
AIRDCPP_WEB_URL=https://airdcpp.example.com
